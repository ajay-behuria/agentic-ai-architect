# ---------------------------------------------------------------------------
# LLM provider configuration for the Reader agent.
# Provide ONE provider key. If neither is set, the Reader agent transparently
# falls back to a deterministic regex parser (fully offline, no key required).
# NEVER commit real keys. Copy this file to `.env` and fill in your values.
# ---------------------------------------------------------------------------

# Option 1: OpenAI
OPENAI_API_KEY=

# Option 2: Anthropic
ANTHROPIC_API_KEY=

# Optional: override the default model name for the selected provider.
# OpenAI default:    gpt-4o-mini
# Anthropic default: claude-3-5-sonnet-latest
LLM_MODEL=
